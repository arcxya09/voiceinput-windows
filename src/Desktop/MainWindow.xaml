<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:RealtimeTranscription.Desktop" x:Class="RealtimeTranscription.Desktop.MainWindow" Title="VoiceInput">
    <Grid x:Name="MainRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:DateTimeLabelConverter x:Key="DateTimeLabel"/>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="StretchListItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="208" CompactModeThresholdWidth="700" ExpandedModeThresholdWidth="1040" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,12,8,22">
                    <Image Source="ms-appx:///Assets/Logo.png" Width="30" Height="30"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VoiceInput" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="语音输入 · 2.1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="听写" Icon="Microphone" Tag="0"/>
                <NavigationViewItem x:Name="HistoryTab" Content="历史" Icon="Clock" Tag="1"/>
                <NavigationViewItem x:Name="VocabularyTab" Content="词库" Icon="Library" Tag="2"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Icon="Setting" Tag="3"/>
                <NavigationViewItem Content="用量与帮助" Icon="Help" Tag="4"/>
            </NavigationView.FooterMenuItems>
            <NavigationView.Header>
                <Grid Margin="0,4,24,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PageTitle" Text="听写" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotkeyHint" Text="按住说话 · 松开输入" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="StateLabel" Text="准备中" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                </Grid>
            </NavigationView.Header>
            <Grid x:Name="PageHost" Margin="24,12,24,16">
                <!-- Pages stay instantiated to preserve live operations and unsaved settings. -->
                <ScrollViewer x:Name="LivePage" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <Grid x:Name="LivePageLayout" MaxWidth="1000" HorizontalAlignment="Stretch" MinHeight="540" Height="{Binding ActualHeight, ElementName=LivePage}" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="12">
                        <local:ResponsivePanel Spacing="8">
                            <ComboBox x:Name="ProjectBox" Width="230" MinWidth="130" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Project_Changed" AutomationProperties.Name="当前项目" ToolTipService.ToolTip="当前项目"/>
                            <Button Content="新建项目" Click="NewProject_Click"/>
                            <Button x:Name="StartButton" Content="启用按住说话" Style="{StaticResource AccentButtonStyle}" Click="Start_Click"/>
                            <Button x:Name="PauseButton" Content="暂停快捷键" Click="Pause_Click"/>
                        </local:ResponsivePanel>
                        <CheckBox x:Name="DictationOnlyBox" Content="仅听写，完成后自动复制" Checked="DictationMode_Changed" Unchecked="DictationMode_Changed"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" MinHeight="120">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Padding="16,10,10,10" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BodyCount" Text="正文 · 0 字" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="对照与编辑" Click="Review_Click"/>
                                <Button Grid.Column="2" Content="复制正文" Click="Copy_Click"/>
                                <Button Grid.Column="3" AutomationProperties.Name="更多正文操作" ToolTipService.ToolTip="更多正文操作">
                                    <FontIcon Glyph="" FontSize="16"/>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="停止并复制" Icon="Copy" Click="StopCopy_Click"/>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="导出 TXT" Icon="Save" Click="ExportTxt_Click"/>
                                            <MenuFlyoutItem Text="导出 Markdown" Icon="Save" Click="ExportMd_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="20" BorderThickness="0" Padding="20,16" Background="Transparent" PlaceholderText="识别后的正文会显示在这里。" AutomationProperties.Name="听写正文" ScrollViewer.HorizontalScrollMode="Disabled"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                        <Grid RowSpacing="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RecordStageText" Text="本轮识别预览" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="MicLevel" Grid.Column="1" Height="4" Minimum="0" Maximum="1" VerticalAlignment="Center" AutomationProperties.Name="麦克风音量"/>
                                <Button x:Name="StopButton" Grid.Column="2" Content="取消本轮" Click="Stop_Click"/>
                            </Grid>
                            <TextBox x:Name="PreviewBox" Grid.Row="1" Text="" IsReadOnly="True" TextWrapping="Wrap" FontSize="15" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="24" MaxHeight="54" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="开始说话后，在这里查看实时文字。" AutomationProperties.Name="实时识别预览" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Spacing="6">
                        <Border x:Name="SaveWarningPanel" Background="{ThemeResource InfoBarWarningSeverityBackgroundBrush}" CornerRadius="8" Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SaveWarningText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button x:Name="RetrySaveButton" Grid.Column="1" Content="重试保存" Click="RetrySave_Click"/>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SessionLearningBox" Content="允许当前会话用于词条整理" IsEnabled="False" Checked="SessionLearning_Changed" Unchecked="SessionLearning_Changed"/>
                            <Button Grid.Column="1" Content="查看本轮词库" Click="LexiconReport_Click"/>
                        </Grid>
                        <TextBlock x:Name="LexiconLiveStatus" Style="{StaticResource SecondaryText}"/>
                        <TextBlock x:Name="SaveLabel" Text="正在准备…" Style="{StaticResource SecondaryText}" FontSize="12"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <Grid x:Name="HistoryPageLayout" MinHeight="350" Height="{Binding ActualHeight, ElementName=HistoryPage}" RowSpacing="14" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:ResponsivePanel Spacing="10">
                        <TextBox x:Name="HistoryQuery" Width="230" KeyDown="HistoryQuery_KeyDown" PlaceholderText="搜索会话与正文" AutomationProperties.Name="搜索历史"/>
                        <CheckBox x:Name="AllProjects" Content="全部项目"/>
                        <ComboBox x:Name="HistoryDays" Width="130" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="历史时间范围">
                            <ComboBoxItem Content="全部时间"/>
                            <ComboBoxItem Content="最近 7 天"/>
                            <ComboBoxItem Content="最近 30 天"/>
                        </ComboBox>
                        <Button x:Name="HistorySearchButton" Content="搜索" Click="HistorySearch_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="取消" Click="HistoryCancel_Click"/>
                    </local:ResponsivePanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <ListView x:Name="HistoryGrid" SelectionChanged="UiSelection_Changed" SelectionMode="Single" DoubleTapped="HistoryOpen_Click" ItemContainerStyle="{StaticResource StretchListItem}" AutomationProperties.Name="历史会话">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowSpacing="6" ColumnSpacing="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Session.Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Session.CreatedAt, Converter={StaticResource DateTimeLabel}}" Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Snippet}" Style="{StaticResource SecondaryText}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right">
                                            <Run Text="{Binding SegmentCount}"/>
                                            <Run Text=" 个片段"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <StackPanel Grid.Row="2" Spacing="10">
                        <local:ResponsivePanel Spacing="8">
                            <Button x:Name="HistoryOpenButton" IsEnabled="False" Content="载入并查看" Click="HistoryOpen_Click"/>
                            <Button x:Name="HistoryMoreButton" IsEnabled="False" Content="更多操作">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="导出记忆记录 JSON" Click="HistoryExport_Click"/>
                                        <MenuFlyoutItem Text="清除选中会话" Icon="Delete" Click="HistoryDelete_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="HistoryExtractAllButton" Content="提取全部历史词条" Click="ExtractAllHistory_Click"/>
                            <Button x:Name="HistoryCancelButton" Content="取消提取" Click="CancelHistory_Click" IsEnabled="False"/>
                        </local:ResponsivePanel>
                        <TextBlock x:Name="HistoryStatus" Text="点击搜索，查看已保存的会话。" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
                <Grid x:Name="VocabularyPage" Visibility="Collapsed">
                    <TabView x:Name="VocabularyTabs" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent">
                        <TabViewItem Header="词条管理" IsClosable="False">
                            <ScrollViewer x:Name="TermsPage" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <Grid MinHeight="390" Height="{Binding ActualHeight, ElementName=TermsPage}" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <local:ResponsivePanel Spacing="8">
                                    <TextBox x:Name="TermQuery" Width="230" PlaceholderText="筛选词条" TextChanged="TermFilter_Changed" AutomationProperties.Name="筛选词条"/>
                                    <ComboBox x:Name="TermFilter" Width="130" SelectedIndex="0" SelectionChanged="TermFilter_Changed" HorizontalAlignment="Stretch" AutomationProperties.Name="词条状态">
                                        <ComboBoxItem Content="全部词条"/>
                                        <ComboBoxItem Content="已启用"/>
                                        <ComboBoxItem Content="待确认"/>
                                        <ComboBoxItem Content="已禁用"/>
                                    </ComboBox>
                                    <Button Content="添加" Style="{StaticResource AccentButtonStyle}" Click="TermAdd_Click"/>
                                    <Button x:Name="TermEditButton" IsEnabled="False" Content="编辑" Click="TermEdit_Click"/>
                                    <Button Content="更多操作">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="确认选中词条" Icon="Accept" Click="TermConfirm_Click"/>
                                                <MenuFlyoutItem Text="禁用选中词条" Click="TermDisable_Click"/>
                                                <MenuFlyoutItem Text="删除选中词条" Icon="Delete" Click="TermDelete_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="查看词条来源" Click="TermEvidence_Click"/>
                                                <MenuFlyoutItem Text="查看下轮热词" Click="NextHotwords_Click"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="导入 TXT / CSV / JSON" Icon="Import" Click="TermImport_Click"/>
                                                <MenuFlyoutItem Text="导出词库" Icon="Save" Click="TermExport_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </local:ResponsivePanel>
                                <local:ResponsivePanel Grid.Row="1" Spacing="8">
                                    <Button x:Name="ExtractButton" Content="整理当前会话词条" Click="Extract_Click"/>
                                    <Button Content="取消整理" Click="ExtractCancel_Click"/>
                                    <Button Content="更新领域词库" Click="DomainRefresh_Click"/>
                                    <Button Content="查看领域分析" Click="DomainReport_Click"/>
                                    <TextBlock MaxWidth="420" Text="历史提取词需确认；智能预测词低权重试用，下轮生效。" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </local:ResponsivePanel>
                                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                                    <ListView x:Name="TermsGrid" SelectionChanged="UiSelection_Changed" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" DoubleTapped="TermEdit_Click" ItemContainerStyle="{StaticResource StretchListItem}" AutomationProperties.Name="词库词条">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid RowSpacing="5" ColumnSpacing="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Category}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ScopeLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SecondaryText}">
                                                        <Run Text="手动权重 "/>
                                                        <Run Text="{Binding Weight}"/>
                                                        <Run Text="    使用会话 "/>
                                                        <Run Text="{Binding UsageCount}"/>
                                                        <Run Text="    人工纠正 "/>
                                                        <Run Text="{Binding CorrectionCount}"/>
                                                        <Run Text="    建议权重 "/>
                                                        <Run Text="{Binding SuggestedWeight}"/>
                                                    </TextBlock>
                                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16">
                                                        <TextBlock Text="{Binding OriginLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                        <CheckBox Content="保护写法" IsChecked="{Binding Protect, Mode=OneWay}" IsHitTestVisible="False" IsTabStop="False" MinHeight="24" FontSize="12"/>
                                                        <CheckBox Content="置顶" IsChecked="{Binding Pinned, Mode=OneWay}" IsHitTestVisible="False" IsTabStop="False" MinHeight="24" FontSize="12"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                                <TextBlock x:Name="TermsCount" Grid.Row="3" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem IsClosable="False">
                            <TabViewItem.Header>
                                <TextBlock x:Name="CorrectionTabLabel" Text="纠错学习"/>
                            </TabViewItem.Header>
                            <ScrollViewer x:Name="CorrectionsPage" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <Grid MinHeight="350" Height="{Binding ActualHeight, ElementName=CorrectionsPage}" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CorrectionHint" Text="保存手动修订后自动发现候选，确认后用于后续识别。" Style="{StaticResource SecondaryText}"/>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CorrectionQuery" PlaceholderText="筛选旧写法或新写法" TextChanged="CorrectionFilter_Changed" AutomationProperties.Name="筛选纠错记录"/>
                                    <ComboBox x:Name="CorrectionFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="CorrectionFilter_Changed" HorizontalAlignment="Stretch" AutomationProperties.Name="纠错状态">
                                        <ComboBoxItem Content="待确认"/>
                                        <ComboBoxItem Content="已学习"/>
                                        <ComboBoxItem Content="已忽略"/>
                                        <ComboBoxItem Content="全部"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="刷新" Click="CorrectionRefresh_Click"/>
                                </Grid>
                                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                                    <ListView x:Name="CorrectionsGrid" SelectionChanged="UiSelection_Changed" SelectionMode="Single" DoubleTapped="CorrectionLearn_Click" ItemContainerStyle="{StaticResource StretchListItem}" AutomationProperties.Name="纠错候选">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="7">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Original}" FontSize="16" TextWrapping="Wrap"/>
                                                        <FontIcon Grid.Column="1" Glyph="" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding StateLabel}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource SecondaryText}">
                                                        <Run Text="纠正 "/>
                                                        <Run Text="{Binding Count}"/>
                                                        <Run Text=" 次    "/>
                                                        <Run Text="{Binding FrequencyLabel}"/>
                                                        <Run Text="    "/>
                                                        <Run Text="{Binding ReplacementLabel}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ReplacementReason}" Style="{StaticResource SecondaryText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                                <StackPanel Grid.Row="3" Spacing="10">
                                    <ContentControl x:Name="CorrectionActions" HorizontalContentAlignment="Stretch">
                                        <local:ResponsivePanel Spacing="8">
                                            <Button Content="确认学习…" Style="{StaticResource AccentButtonStyle}" Click="CorrectionLearn_Click"/>
                                            <Button Content="查看来源" Click="CorrectionEvidence_Click"/>
                                            <Button Content="启用自动纠正…" Click="CorrectionEnableReplacement_Click"/>
                                            <Button Content="更多操作">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="忽略候选" Click="CorrectionIgnore_Click"/>
                                                        <MenuFlyoutItem Text="恢复候选" Click="CorrectionRestore_Click"/>
                                                        <MenuFlyoutItem Text="撤销学习" Click="CorrectionRevoke_Click"/>
                                                        <MenuFlyoutItem Text="关闭自动纠正" Click="CorrectionDisableReplacement_Click"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </local:ResponsivePanel>
                                    </ContentControl>
                                    <TextBlock x:Name="CorrectionStatus" Text="尚无纠错记录。在“对照与编辑”中保存修订后自动发现。" Style="{StaticResource SecondaryText}"/>
                                </StackPanel>
                            </Grid>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="AI 生成" IsClosable="False">
                            <ScrollViewer MaxWidth="900" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="8,16,8,12" Spacing="16" HorizontalAlignment="Stretch">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="生成专业词库" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="描述你的领域和要求，生成后逐项检查，再导入到当前项目或全局词库。" Style="{StaticResource SecondaryText}"/>
                                            <ContentControl x:Name="GenerationRequestPanel" HorizontalContentAlignment="Stretch">
                                                <StackPanel Spacing="12">
                                                    <TextBox x:Name="GenerationRequirementBox" Header="领域与要求" Height="108" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxLength="1000" PlaceholderText="例如：生成 100 个核天体物理领域的专业词条，包含核反应与实验装置名称。" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="GenerationCountBox" Header="目标词数" Text="100" MaxLength="3"/>
                                                        <ComboBox x:Name="GenerationScopeBox" Grid.Column="1" Header="导入范围" SelectedIndex="0" SelectionChanged="GenerationScope_Changed" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="当前项目"/>
                                                            <ComboBoxItem Content="全局词库"/>
                                                        </ComboBox>
                                                    </Grid>
                                                    <CheckBox x:Name="GenerationMaxThinkingBox" Content="开启 Max 思考深度"/>
                                                    <TextBlock Text="Max 模式会增加等待时间和 Token 用量，每批最多预留 32,768 个输出 Token（含思考）。预算不足时停止并保留已有结果。" Style="{StaticResource SecondaryText}"/>
                                                </StackPanel>
                                            </ContentControl>
                                            <local:ResponsivePanel Spacing="8">
                                                <Button x:Name="GenerateTermsButton" Content="生成词库" Click="GenerateTerms_Click" Style="{StaticResource AccentButtonStyle}"/>
                                                <Button x:Name="CancelGenerationButton" Content="取消生成" Click="CancelGeneration_Click" IsEnabled="False"/>
                                            </local:ResponsivePanel>
                                            <TextBlock Text="使用设置中的 DeepSeek Key，每次 1—500 个词条。生成和历史整理共用每日预算，结果不会自动启用。" Style="{StaticResource SecondaryText}"/>
                                            <ProgressBar x:Name="GenerationProgressBar" Maximum="100" Minimum="0" AutomationProperties.Name="词库生成进度"/>
                                            <TextBlock x:Name="GenerationStatus" Text="生成后可修改词条、勾选并导入。" Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="检查与导入" Style="{StaticResource SectionTitle}"/>
                                            <ListView x:Name="GeneratedTermsGrid" Height="290" SelectionMode="None" ItemContainerStyle="{StaticResource StretchListItem}" AutomationProperties.Name="生成词条预览">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="10" RowSpacing="4">
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="选中此词条"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="词条" AutomationProperties.Name="词条写法"/>
                                                            <TextBox Grid.Column="2" Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="类别" AutomationProperties.Name="词条类别"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Status}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <local:ResponsivePanel Spacing="8">
                                                <Button x:Name="GeneratedSelectAllButton" Content="全选可导入" Click="GeneratedSelectAll_Click"/>
                                                <Button x:Name="GeneratedSelectNoneButton" Content="取消全选" Click="GeneratedSelectNone_Click"/>
                                                <CheckBox x:Name="GeneratedEnableBox" Content="导入后启用" IsChecked="True" Margin="8,0,0,0"/>
                                            </local:ResponsivePanel>
                                            <TextBlock x:Name="GeneratedSelectionStatus" Text="尚未生成词条。" Style="{StaticResource SecondaryText}"/>
                                            <Button x:Name="ImportGeneratedButton" Content="导入选中词条" Click="ImportGenerated_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                </Grid>
                <Grid x:Name="SettingsPage" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer MaxWidth="850" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="8,0,8,12" Spacing="16" HorizontalAlignment="Stretch">
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="语音识别" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="阿里云百炼 · qwen-audio-3.0-asr-flash-streaming" Style="{StaticResource SecondaryText}"/>
                                    <PasswordBox x:Name="BailianKeyBox" Header="API Key" PasswordRevealMode="Peek"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="RegionBox" Header="服务地域" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="北京"/>
                                            <ComboBoxItem Content="新加坡"/>
                                        </ComboBox>
                                        <TextBox x:Name="WorkspaceBox" Grid.Column="1" Header="Workspace ID" PlaceholderText="业务空间 ID"/>
                                    </Grid>
                                    <CheckBox x:Name="LegacyBox"><TextBlock Text="使用兼容地址（无需 Workspace ID）" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="HighAccuracyBox" Content="高精度模式：松开后复核整段语音（默认开启）"/>
                                    <TextBlock Text="使用百炼再次识别完整录音，会增加一次识别费用和等待时间。单次最多复核 3 分钟，最长等待 12 秒；失败或超时使用实时结果。回车跳过等待，Esc 取消输入。音频仅暂存内存。" Style="{StaticResource SecondaryText}"/>
                                    <CheckBox x:Name="AdaptiveAsrBox" Content="根据音量和背景噪声自动调整识别灵敏度"/>
                                    <CheckBox x:Name="SmartPunctuationBox" Content="智能标点：短输入省略句末句号"/>
                                    <TextBlock Text="适用于单词、短语和简短单句；保留问号、感叹号、多句及专业符号。关闭润色或润色超时也会生效。" Style="{StaticResource SecondaryText}"/>
                                    <Button x:Name="TestBailianButton" Content="保存设置并测试百炼" Click="TestBailian_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="全文润色" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="DeepSeek · 松开后统一整理全文，保护原意、数字与专业词条。" Style="{StaticResource SecondaryText}"/>
                                    <PasswordBox x:Name="DeepSeekKeyBox" Header="API Key" PasswordRevealMode="Peek"/>
                                    <CheckBox x:Name="PolishBox" Content="启用轻量润色"/>
                                    <CheckBox x:Name="FastDeliveryBox" Content="优先快速上屏"/>
                                    <TextBlock Text="语音复核完成后，自动复制或上屏最多等待润色 0.8 秒，超时使用完整识别正文及已确认纠错；关闭后等待完整润色。松手后回车加速、Esc 取消。" Style="{StaticResource SecondaryText}"/>
                                    <CheckBox x:Name="PreviousBox" Visibility="Collapsed" Content="旧版分片上下文设置"/>
                                    <Button x:Name="TestDeepSeekButton" Content="保存设置并测试 DeepSeek" Click="TestDeepSeek_Click"/>
                                    <TextBlock Text="连接测试会发起少量 API 调用。deepseek-flash 使用非思考模式，仅返回整理后的正文。" Style="{StaticResource SecondaryText}"/>
                                    <Expander Header="编辑与试用润色提示词" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <ContentControl x:Name="PromptEditorPanel" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="在默认提示词上修改，保存后用于之后的润色。超出轻量整理范围时，程序会保留原文。" Style="{StaticResource SecondaryText}"/>
                                                <TextBox x:Name="PolishPromptBox" Header="润色提示词" Height="240" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxLength="8000" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                <local:ResponsivePanel Spacing="8">
                                                    <Button Content="保存提示词" Click="PromptSave_Click"/>
                                                    <Button Content="恢复默认" Click="PromptReset_Click"/>
                                                </local:ResponsivePanel>
                                                <TextBox x:Name="PolishSampleBox" Header="试用文本" Height="88" Text="嗯，这个方案我们先试一下。" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxLength="600" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                <Button x:Name="PromptTestButton" Content="试用当前提示词" Click="PromptTest_Click"/>
                                                <TextBox x:Name="PromptResultBox" Header="试用结果" MinHeight="56" MaxHeight="180" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                <TextBlock x:Name="PromptTestStatus" Text="试用会调用上方 DeepSeek Key，产生少量用量；无需先保存提示词。" Style="{StaticResource SecondaryText}"/>
                                            </StackPanel>
                                        </ContentControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="麦克风与操作" Style="{StaticResource SectionTitle}"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DeviceBox" Header="输入设备" DisplayMemberPath="Name" SelectedValuePath="Id" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="刷新设备" Click="Devices_Click" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <local:ResponsivePanel Spacing="8">
                                        <Button x:Name="TestMicrophoneButton" Content="本地麦克风测试（3 秒）" Click="TestMicrophone_Click"/>
                                        <Button Content="查看录音诊断" Click="Diagnostics_Click"/>
                                        <Button x:Name="ExportLogButton" Content="导出运行日志" Click="ExportLog_Click"/>
                                    </local:ResponsivePanel>
                                    <TextBlock Text="已选设备断开或失效时，临时使用 Windows 默认通信麦克风。麦克风测试不上传音频。启动失败后请先查看录音诊断，再运行测试；诊断不包含 Key、录音或识别正文。" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock x:Name="LogStatusText" Text="正在准备运行日志…" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="日志自动记录启动、设备、识别和上屏过程，保留最近 7 天、最多 10 个文件。导出为一个 .log 文件，不包含 Key、录音或识别正文。" Style="{StaticResource SecondaryText}"/>
                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ComboBox x:Name="HotkeyBox" Header="按住说话键" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="RightCtrl"/>
                                            <ComboBoxItem Content="F8"/>
                                            <ComboBoxItem Content="F9"/>
                                        </ComboBox>
                                        <TextBox x:Name="SilenceBox" Grid.Column="1" Header="断句停顿（ms）"/>
                                        <TextBox x:Name="HoldBox" Grid.Row="1" Header="长按确认（ms）"/>
                                        <TextBox x:Name="MaxHoldBox" Grid.Row="1" Grid.Column="1" Header="最长按住（秒）"/>
                                    </Grid>
                                    <TextBlock Text="连续录音默认 600 秒，可设 30—1800 秒。断句停顿默认 2500 ms，可设 200—6000 ms；停顿只影响识别确认。" Style="{StaticResource SecondaryText}"/>
                                    <CheckBox x:Name="ParagraphBox" Content="长停顿 2 秒时另起自然段"/>
                                    <CheckBox x:Name="TrayBox" Content="关闭管理窗口时收至托盘"/>
                                    <ToggleSwitch x:Name="StartupToggle" Header="开机自启动" OnContent="开启" OffContent="关闭" Toggled="StartupToggle_Toggled"/>
                                    <TextBlock x:Name="StartupStatusText" Style="{StaticResource SecondaryText}"/>
                                    <HyperlinkButton Content="打开 Windows 启动应用设置" Click="OpenWindowsStartupSettings_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="UpdateVersionText" Style="{StaticResource SecondaryText}"/>
                                    <CheckBox x:Name="AutoCheckUpdateBox"><TextBlock Text="启动后自动检查新版（每 6 小时）" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="AutoDownloadUpdateBox"><TextBlock Text="发现新版后自动下载安装包" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="AutoInstallUpdateBox"><TextBlock Text="托盘空闲 1 分钟后自动退出并打开安装程序（仅安装版）" TextWrapping="Wrap"/></CheckBox>
                                    <TextBlock Text="以上选项点击页面底部“保存设置”生效。自动打开安装程序默认关闭，安装向导由你完成。" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock x:Name="UpdateModeText" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock x:Name="UpdateStatusText" Text="尚未检查更新。" Style="{StaticResource SecondaryText}"/>
                                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                    <local:ResponsivePanel Spacing="8">
                                        <Button x:Name="UpdateCheckButton" Content="检查更新" Click="UpdateCheck_Click"/>
                                        <Button x:Name="UpdateDownloadButton" Content="下载 / 重新下载" Click="UpdateDownload_Click" IsEnabled="False"/>
                                        <Button x:Name="UpdateInstallButton" Content="退出并安装" Click="UpdateInstall_Click" IsEnabled="False"/>
                                        <Button x:Name="UpdateCancelButton" Content="取消下载" Click="UpdateCancel_Click" IsEnabled="False"/>
                                        <Button Content="版本说明" Click="UpdateRelease_Click"/>
                                    </local:ResponsivePanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="记忆与词库" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                    <CheckBox x:Name="MemoryBox" Content="保存本地文本记忆"/>
                                    <CheckBox x:Name="LearningBox" Content="允许词条整理（新会话默认）"/>
                                    <CheckBox x:Name="UseTermsBox"><TextBlock Text="启用词库（识别热词、保护与确认纠错）" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="DynamicTermsBox"><TextBlock Text="根据使用与人工纠错调整热词优先级（需允许本地学习）" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="CorrectionLearningBox"><TextBlock Text="从手动修订中发现纠错候选（本地比较，确认后学习）" TextWrapping="Wrap"/></CheckBox>
                                    <CheckBox x:Name="AutoExtractBox" Content="停止后自动提取原文词条（待确认）"/>
                                    <CheckBox x:Name="DomainLexiconBox"><TextBlock Text="智能领域词库：根据历史预测易错词，后台更新并低权重试用" TextWrapping="Wrap"/></CheckBox>
                                    <TextBlock Text="开启后，将本项目近期及较早的部分历史文本发送给 DeepSeek，识别话题并生成少量相关易错词。模型预测不代表实测错误；不依赖其他软件中的修改记录。可在词库查看依据、禁用或删除，关闭此项即停止预测词注入。" Style="{StaticResource SecondaryText}"/>
                                    <CheckBox x:Name="AsrContextBox" Content="向 ASR 提供已选领域词上下文"/>
                                    <Grid ColumnSpacing="16" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RetentionBox" Header="保留天数" PlaceholderText="留空为长期保留"/>
                                        <TextBox x:Name="BudgetBox" Grid.Column="1" Header="每日词库 AI Token 预算（UTC）"/>
                                    </Grid>
                                    <TextBlock Text="已有会话可在“听写”页面单独设置整理许可。原文提取生成待确认候选；智能领域词库自动低权重试用。两者共用每日预算。默认不保存录音，每日预算按 UTC 日期重置。" Style="{StaticResource SecondaryText}"/>
                                </StackPanel>
                            </Border>
                            <Expander Header="从全部历史提取词条" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="遍历所有项目中已保存、允许整理的历史输入，分批发送原文或手动修订文本给 DeepSeek。新词保存到来源项目并等待确认。已整理版本自动跳过，取消或预算耗尽后可继续。" Style="{StaticResource SecondaryText}"/>
                                    <local:ResponsivePanel Spacing="8">
                                        <Button x:Name="AllHistoryButton" Content="提取全部历史词条" Click="ExtractAllHistory_Click"/>
                                        <Button x:Name="CancelHistoryButton" Content="取消历史提取" Click="CancelHistory_Click" IsEnabled="False"/>
                                    </local:ResponsivePanel>
                                    <ProgressBar x:Name="HistoryExtractionProgressBar" Maximum="1" AutomationProperties.Name="历史词条提取进度"/>
                                    <TextBlock x:Name="HistoryExtractionStatus" Text="覆盖全部已保存记录，不受历史列表最多显示 500 条的限制。" Style="{StaticResource SecondaryText}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="数据恢复与项目管理" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="保存失败时，可先复制或导出正文，再重试保存。删除项目将同时清除该项目的记忆与项目词条。" Style="{StaticResource SecondaryText}"/>
                                    <local:ResponsivePanel Spacing="8">
                                        <Button Content="重试保存未保存内容" Click="RetrySave_Click"/>
                                        <Button Content="删除当前项目" Click="DeleteProject_Click"/>
                                    </local:ResponsivePanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" MaxWidth="850" HorizontalAlignment="Stretch" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="修改完成后保存，新的识别任务将使用最新设置。" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                        <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="保存设置" Style="{StaticResource AccentButtonStyle}" Click="SettingsSave_Click"/>
                    </Grid>
                </Grid>
                <ScrollViewer x:Name="HelpPage" MaxWidth="850" HorizontalAlignment="Stretch" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="16" Margin="8,0,8,12" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="使用方法" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="UsageHelp" TextWrapping="Wrap" LineHeight="27"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="本地用量记录" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <Button x:Name="UsageRefreshButton" Grid.Column="1" Content="刷新" Click="Usage_Click"/>
                                </Grid>
                                <TextBox x:Name="UsageBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="260" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="本地用量记录" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="VersionInfo" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Text="正在初始化…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=StatusText}"/>
        </Border>
    </Grid>
</Window>
