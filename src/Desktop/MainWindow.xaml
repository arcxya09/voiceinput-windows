<Window x:Class="RealtimeTranscription.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="语音输入法" Icon="Assets/AppIcon.ico" Width="1180" Height="860" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid Margin="22,18,22,14"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Border DockPanel.Dock="Right" Background="#E0EFEA" CornerRadius="14" Padding="15,6" VerticalAlignment="Top"><TextBlock x:Name="StateLabel" Text="准备中" Foreground="#226E67"/></Border><Image Source="Assets/Logo.png" Width="48" Height="48" DockPanel.Dock="Left" Margin="0,0,12,10"/><StackPanel><TextBlock Text="语音输入法" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="按住右侧 Ctrl 说话 · 松开输入 · 记忆与词库" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderBrush="#DCE4EC">
   <TabItem Header="最近输入"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="项目" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox x:Name="ProjectBox" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,12,8" SelectionChanged="Project_Changed"/><Button Content="新建项目" Click="NewProject_Click"/><Button Content="启用按住说话" x:Name="StartButton" Background="#226E67" Foreground="White" Click="Start_Click"/><Button Content="暂停快捷键" x:Name="PauseButton" Click="Pause_Click"/><Button Content="取消本轮" x:Name="StopButton" Click="Stop_Click"/></WrapPanel>
    <DockPanel Grid.Row="1" Margin="0,5,0,7"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="对照与编辑" Click="Review_Click"/><Button Content="复制正文" Click="Copy_Click"/><Button Content="停止并复制" Click="StopCopy_Click"/><Button Content="导出 TXT" Click="ExportTxt_Click"/><Button Content="导出 Markdown" Click="ExportMd_Click"/></StackPanel><TextBlock x:Name="BodyCount" Text="正文 · 0 字" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
    <Border Grid.Row="2" Background="White" BorderBrush="#DCE4EC" BorderThickness="1" CornerRadius="8"><TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="20" BorderThickness="0" Padding="18" Background="Transparent"/></Border>
    <Border Grid.Row="3" Background="#EAF0F5" CornerRadius="7" Padding="14,10" Margin="0,12,0,0"><StackPanel><DockPanel><ProgressBar x:Name="MicLevel" DockPanel.Dock="Right" Width="110" Height="5" Minimum="0" Maximum="1" Foreground="#226E67" Background="#D0DCE3"/><TextBlock Text="识别中" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel><TextBox x:Name="PreviewBox" Text="" IsReadOnly="True" TextWrapping="Wrap" FontSize="17" BorderThickness="0" Background="Transparent" Padding="0,7,0,0" MinHeight="44" MaxHeight="90" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
    <StackPanel Grid.Row="4"><CheckBox x:Name="SessionLearningBox" Content="允许当前会话用于词条整理" IsEnabled="False" Checked="SessionLearning_Changed" Unchecked="SessionLearning_Changed"/><TextBlock x:Name="SaveLabel" Text="正在准备…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="历史记忆"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><TextBox x:Name="HistoryQuery" Width="290" ToolTip="搜索原文、正文和会话标题" Margin="0,0,10,8"/><CheckBox x:Name="AllProjects" Content="全部项目"/><ComboBox x:Name="HistoryDays" SelectedIndex="0" Width="120" Margin="0,0,10,8"><ComboBoxItem Content="全部时间"/><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="最近 30 天"/></ComboBox><Button Content="搜索 / 刷新" Click="HistorySearch_Click"/><Button Content="取消搜索" Click="HistoryCancel_Click"/></WrapPanel>
    <DataGrid x:Name="HistoryGrid" Grid.Row="1" SelectionMode="Single" MouseDoubleClick="HistoryOpen_Click"><DataGrid.Columns><DataGridTextColumn Header="会话" Binding="{Binding Session.Title}" Width="210"/><DataGridTextColumn Header="内容摘录" Binding="{Binding Snippet}" Width="*"/><DataGridTextColumn Header="片段" Binding="{Binding SegmentCount}" Width="65"/><DataGridTextColumn Header="创建时间" Binding="{Binding Session.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="155"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="载入并查看" Click="HistoryOpen_Click"/><Button Content="导出记忆记录 JSON" Click="HistoryExport_Click"/><Button Content="清除选中会话" Click="HistoryDelete_Click"/><Button x:Name="HistoryExtractAllButton" Content="提取全部历史词条" Click="ExtractAllHistory_Click"/><Button x:Name="HistoryCancelButton" Content="取消提取" Click="CancelHistory_Click" IsEnabled="False"/><TextBlock x:Name="HistoryStatus" Text="点击搜索，查看已保存的会话。" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="词库"><TabControl x:Name="VocabularyTabs" Background="Transparent" BorderThickness="0"><TabItem Header="词条管理"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><TextBox x:Name="TermQuery" Width="220" Margin="0,0,10,8" TextChanged="TermFilter_Changed" ToolTip="筛选词条"/><ComboBox x:Name="TermFilter" Width="110" SelectedIndex="0" SelectionChanged="TermFilter_Changed" Margin="0,0,10,8"><ComboBoxItem Content="全部词条"/><ComboBoxItem Content="已启用"/><ComboBoxItem Content="待确认"/><ComboBoxItem Content="已禁用"/></ComboBox><Button Content="添加" Click="TermAdd_Click"/><Button Content="编辑" Click="TermEdit_Click"/><Button Content="批量确认" Click="TermConfirm_Click"/><Button Content="禁用" Click="TermDisable_Click"/><Button Content="删除" Click="TermDelete_Click"/><Button Content="来源" Click="TermEvidence_Click"/></WrapPanel>
    <WrapPanel Grid.Row="1"><Button Content="导入 TXT / CSV / JSON" Click="TermImport_Click"/><Button Content="导出词库" Click="TermExport_Click"/><Button x:Name="ExtractButton" Content="整理当前会话词条" Click="Extract_Click"/><Button Content="取消整理" Click="ExtractCancel_Click"/><TextBlock Text="候选词确认后参与识别，录音中的热词变更在下次任务生效。" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></WrapPanel>
    <DataGrid x:Name="TermsGrid" Grid.Row="2" MouseDoubleClick="TermEdit_Click"><DataGrid.Columns><DataGridTextColumn Header="词条" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="90"/><DataGridTextColumn Header="范围" Binding="{Binding ScopeLabel}" Width="80"/><DataGridTextColumn Header="权重" Binding="{Binding Weight}" Width="60"/><DataGridCheckBoxColumn Header="保护写法" Binding="{Binding Protect}" Width="85"/><DataGridCheckBoxColumn Header="置顶" Binding="{Binding Pinned}" Width="60"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="3" x:Name="TermsCount" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
   </Grid></TabItem>
    <TabItem><TabItem.Header><TextBlock x:Name="CorrectionTabLabel" Text="纠错学习"/></TabItem.Header>
     <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="CorrectionHint" Text="保存手动修订后自动发现候选，确认后用于后续识别。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
      <WrapPanel Grid.Row="1"><TextBox x:Name="CorrectionQuery" Width="220" ToolTip="筛选旧写法或新写法" TextChanged="CorrectionFilter_Changed" Margin="0,0,10,8"/><ComboBox x:Name="CorrectionFilter" Width="110" SelectedIndex="0" SelectionChanged="CorrectionFilter_Changed" Margin="0,0,10,8"><ComboBoxItem Content="待确认"/><ComboBoxItem Content="已学习"/><ComboBoxItem Content="已忽略"/><ComboBoxItem Content="全部"/></ComboBox><Button Content="刷新" Click="CorrectionRefresh_Click"/></WrapPanel>
      <DataGrid x:Name="CorrectionsGrid" Grid.Row="2" SelectionMode="Single" MouseDoubleClick="CorrectionLearn_Click"><DataGrid.Columns><DataGridTextColumn Header="旧写法" Binding="{Binding Original}" Width="*"/><DataGridTextColumn Header="标准写法 / 建议" Binding="{Binding DisplayText}" Width="*"/><DataGridTextColumn Header="纠正次数" Binding="{Binding Count}" Width="90"/><DataGridTextColumn Header="提示" Binding="{Binding FrequencyLabel}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="95"/></DataGrid.Columns></DataGrid>
      <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel x:Name="CorrectionActions"><Button Content="确认学习…" Background="#226E67" Foreground="White" Click="CorrectionLearn_Click"/><Button Content="查看来源" Click="CorrectionEvidence_Click"/><Button Content="忽略" Click="CorrectionIgnore_Click"/><Button Content="恢复候选" Click="CorrectionRestore_Click"/><Button Content="撤销学习" Click="CorrectionRevoke_Click"/></WrapPanel><TextBlock x:Name="CorrectionStatus" Text="尚无纠错记录。在“对照与编辑”中保存修订后自动发现。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
     </Grid>
    </TabItem></TabControl></TabItem>
   <TabItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="850" HorizontalAlignment="Left">
    <TextBlock Text="阿里云百炼" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="API Key"/><PasswordBox x:Name="BailianKeyBox" Width="620" HorizontalAlignment="Left" Margin="0,6,0,12"/>
    <WrapPanel><ComboBox x:Name="RegionBox" Width="150" SelectedIndex="0" Margin="0,0,12,8"><ComboBoxItem Content="北京"/><ComboBoxItem Content="新加坡"/></ComboBox><TextBox x:Name="WorkspaceBox" Width="280" ToolTip="业务空间 Workspace ID" Margin="0,0,12,8"/><CheckBox x:Name="LegacyBox" Content="使用兼容地址（无需 Workspace ID）"/></WrapPanel>
    <TextBlock Text="qwen-audio-3.0-asr-flash-streaming" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><Button Content="保存设置并测试百炼" HorizontalAlignment="Left" Click="TestBailian_Click"/>
    <Separator Margin="0,14,0,14"/><TextBlock Text="DeepSeek 轻量润色" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="API Key"/><PasswordBox x:Name="DeepSeekKeyBox" Width="620" HorizontalAlignment="Left" Margin="0,6,0,10"/><WrapPanel><CheckBox x:Name="PolishBox" Content="启用轻量润色"/><CheckBox x:Name="PreviousBox" Visibility="Collapsed" Content="旧版分片上下文设置"/></WrapPanel>
    <TextBlock Text="deepseek-flash · 松开后全文统一润色 · 非思考模式 · 仅输出结果" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><Button Content="保存设置并测试 DeepSeek" HorizontalAlignment="Left" Click="TestDeepSeek_Click"/><TextBlock Text="连接测试会发起少量 API 调用。" FontSize="12" Foreground="{StaticResource Muted}"/>
    <Expander Header="润色提示词（可编辑）" IsExpanded="False" Margin="0,12,0,12">
     <StackPanel x:Name="PromptEditorPanel" Margin="0,12,0,0">
      <TextBlock Text="在默认提示词上修改，保存后用于之后的润色。程序仍会保护原意、数字和词条；超出轻量整理范围时保留原文。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
      <TextBox x:Name="PolishPromptBox" Height="240" Width="780" HorizontalAlignment="Left" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="8000"/>
      <WrapPanel Margin="0,10,0,0"><Button Content="保存提示词" Click="PromptSave_Click"/><Button Content="恢复默认" Click="PromptReset_Click"/></WrapPanel>
      <TextBlock Text="试用文本" Margin="0,8,0,6"/>
      <TextBox x:Name="PolishSampleBox" Width="780" Height="72" HorizontalAlignment="Left" Text="嗯，这个方案我们先试一下。" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="600"/>
      <Button x:Name="PromptTestButton" Content="试用当前提示词" HorizontalAlignment="Left" Click="PromptTest_Click" Margin="0,10,0,8"/>
      <TextBox x:Name="PromptResultBox" Width="780" MinHeight="42" MaxHeight="150" HorizontalAlignment="Left" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <TextBlock x:Name="PromptTestStatus" Text="试用会调用上方 DeepSeek Key，产生少量用量；无需先保存提示词。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel>
    </Expander>
    <Separator Margin="0,14,0,14"/><TextBlock Text="麦克风与操作" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <WrapPanel><ComboBox x:Name="DeviceBox" Width="510" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,10,8"/><Button Content="刷新设备" Click="Devices_Click"/></WrapPanel>
    <WrapPanel><Button x:Name="TestMicrophoneButton" Content="本地麦克风测试（3 秒）" Click="TestMicrophone_Click"/><Button Content="查看录音诊断" Click="Diagnostics_Click"/></WrapPanel>
    <TextBlock Text="麦克风测试不上传音频，不调用付费 API。诊断不包含 Key、录音或识别正文。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <WrapPanel><TextBlock Text="断句停顿（ms）" VerticalAlignment="Center" Margin="0,0,10,8"/><TextBox x:Name="SilenceBox" Width="95" Margin="0,0,22,8"/><TextBlock Text="按住说话键" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox x:Name="HotkeyBox" Width="185" SelectedIndex="0" Margin="0,0,10,8"><ComboBoxItem Content="RightCtrl"/><ComboBoxItem Content="F8"/><ComboBoxItem Content="F9"/></ComboBox></WrapPanel>
    <WrapPanel><TextBlock Text="长按确认（ms）" VerticalAlignment="Center" Margin="0,0,10,8"/><TextBox x:Name="HoldBox" Width="95" Margin="0,0,22,8"/><TextBlock Text="最长按住（秒）" VerticalAlignment="Center" Margin="0,0,10,8"/><TextBox x:Name="MaxHoldBox" Width="95" Margin="0,0,12,8"/></WrapPanel>
    <TextBlock Text="连续录音默认 600 秒（10 分钟），可设 30—1800 秒。停顿默认 2500 ms，可设 200—6000 ms。停顿只影响识别确认，不会触发分片润色。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
    <WrapPanel><CheckBox x:Name="ParagraphBox" Content="长停顿 2 秒时另起自然段"/><CheckBox x:Name="TrayBox" Content="关闭管理窗口时收至托盘"/></WrapPanel>
    <Separator Margin="0,14,0,14"/><TextBlock Text="记忆与词库" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <WrapPanel><CheckBox x:Name="MemoryBox" Content="保存本地文本记忆"/><CheckBox x:Name="LearningBox" Content="允许词条整理（新会话默认）"/><CheckBox x:Name="UseTermsBox" Content="识别时使用已启用词库"/></WrapPanel>
    <CheckBox x:Name="CorrectionLearningBox" Content="从手动修订中发现纠错候选（本地比较，确认后学习）"/>
    <TextBlock Text="词条整理总开关同时决定新会话的默认许可。已有会话请先载入，再到“最近输入”单独设置许可。每日词库 AI 预算按 UTC 日期重置。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
    <WrapPanel><TextBlock Text="保留天数（留空为长期）" VerticalAlignment="Center" Margin="0,0,10,8"/><TextBox x:Name="RetentionBox" Width="110" Margin="0,0,20,8"/><TextBlock Text="每日词库 AI Token 预算（UTC）" VerticalAlignment="Center" Margin="0,0,10,8"/><TextBox x:Name="BudgetBox" Width="120" Margin="0,0,10,8"/></WrapPanel>
    <WrapPanel><CheckBox x:Name="AutoExtractBox" Content="停止后自动整理词条"/><CheckBox x:Name="AsrContextBox" Content="向 ASR 提供已选领域词上下文"/></WrapPanel>
    <TextBlock Text="词条整理会将选中的已保存文本发送给 DeepSeek，产生单独用量；只生成待确认候选。默认不保存录音音频。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
    <Separator Margin="0,8,0,14"/>
    <TextBlock Text="从全部历史提取词条" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="遍历本软件所有项目中已保存、允许整理的历史输入，向 DeepSeek 分批发送原文或手动修订文本。新增词条保存到来源项目，等待确认。已整理版本自动跳过；取消或预算耗尽后可继续。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
    <WrapPanel><Button x:Name="AllHistoryButton" Content="提取全部历史词条" Click="ExtractAllHistory_Click"/><Button x:Name="CancelHistoryButton" Content="取消历史提取" Click="CancelHistory_Click" IsEnabled="False"/></WrapPanel>
    <ProgressBar x:Name="HistoryExtractionProgressBar" Height="5" Width="780" HorizontalAlignment="Left" Maximum="1" Foreground="#226E67" Margin="0,0,0,8"/>
    <TextBlock x:Name="HistoryExtractionStatus" Text="覆盖全部已保存记录，不受历史列表最多显示 500 条的限制。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Separator Margin="0,8,0,14"/>
    <TextBlock Text="AI 生成专业词库" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="描述领域或要求，例如“生成 100 个 HR 领域的专业词条”。数量以下方目标词数为准。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
    <StackPanel x:Name="GenerationRequestPanel">
     <TextBox x:Name="GenerationRequirementBox" Width="780" Height="90" HorizontalAlignment="Left" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="1000"/>
     <WrapPanel Margin="0,12,0,0"><TextBlock Text="目标词数" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBox x:Name="GenerationCountBox" Text="100" Width="80" Margin="0,0,20,8" MaxLength="3"/><TextBlock Text="导入范围" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="GenerationScopeBox" Width="160" SelectedIndex="0" SelectionChanged="GenerationScope_Changed"><ComboBoxItem Content="当前项目"/><ComboBoxItem Content="全局词库"/></ComboBox></WrapPanel>
     <CheckBox x:Name="GenerationMaxThinkingBox" Content="开启 Max 思考深度（生成专业词库）"/>
     <TextBlock Text="Max 模式会增加等待时间和 Token 用量，每批预留最多 32,768 个输出 Token（含思考）；预算不足时停止并保留已有结果。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
    </StackPanel>
    <WrapPanel><Button x:Name="GenerateTermsButton" Content="生成词库" Click="GenerateTerms_Click" Background="#226E67" Foreground="White"/><Button x:Name="CancelGenerationButton" Content="取消生成" Click="CancelGeneration_Click" IsEnabled="False"/></WrapPanel>
    <TextBlock Text="复用上方 DeepSeek Key，每次 1—500 个，生成结果不会自动启用。生成和会话词条整理共用每日预算。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
    <ProgressBar x:Name="GenerationProgressBar" Height="5" Width="780" HorizontalAlignment="Left" Maximum="100" Minimum="0" Foreground="#226E67" Margin="0,0,0,8"/>
    <TextBlock x:Name="GenerationStatus" Text="生成后可修改词条、勾选并导入。" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="GeneratedTermsGrid" Width="780" Height="280" HorizontalAlignment="Left" IsReadOnly="False" SelectionMode="Extended" CanUserAddRows="False" EnableRowVirtualization="True">
     <DataGrid.Columns>
      <DataGridCheckBoxColumn Header="选中" Width="60" Binding="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
      <DataGridTextColumn Header="词条（可修改）" Width="*" Binding="{Binding Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
      <DataGridTextColumn Header="类别" Width="145" Binding="{Binding Category,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
      <DataGridTextColumn Header="状态" Width="160" IsReadOnly="True" Binding="{Binding Status}"/>
     </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Margin="0,10,0,0"><Button x:Name="GeneratedSelectAllButton" Content="全选可导入" Click="GeneratedSelectAll_Click"/><Button x:Name="GeneratedSelectNoneButton" Content="取消全选" Click="GeneratedSelectNone_Click"/><CheckBox x:Name="GeneratedEnableBox" Content="导入后启用" IsChecked="True"/></WrapPanel>
    <TextBlock x:Name="GeneratedSelectionStatus" Text="尚未生成词条。" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
    <Button x:Name="ImportGeneratedButton" Content="导入选中词条" Click="ImportGenerated_Click" HorizontalAlignment="Left" IsEnabled="False"/>
    <Separator Margin="0,10,0,14"/>
    <WrapPanel><Button Content="保存设置" Background="#226E67" Foreground="White" Click="SettingsSave_Click"/><Button Content="重试保存未保存内容" Click="RetrySave_Click"/><Button Content="删除当前项目" Click="DeleteProject_Click"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="用量与说明"><StackPanel Margin="24"><TextBlock Text="本地用量记录" FontSize="20" FontWeight="SemiBold"/><Button Content="刷新" Click="Usage_Click" HorizontalAlignment="Left" Margin="0,14,0,12"/><TextBox x:Name="UsageBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="230" VerticalScrollBarVisibility="Auto"/><TextBlock Text="使用方法" FontSize="20" FontWeight="SemiBold" Margin="0,25,0,10"/><TextBlock TextWrapping="Wrap" LineHeight="26" Text="1. 在设置中填写百炼和 DeepSeek Key，选择地域、业务空间和麦克风。&#10;2. 在其他应用的文本框中按住右侧 Ctrl，麦克风就绪后说话。松开即停止录音，尾句处理完成后输入。&#10;3. 悬浮提示不抢焦点。不自动按回车；目标改变、识别不完整或输入受限时，结果保留供手动复制。&#10;4. 停止后整理当前会话词条，在词库页确认有用的候选。下次录音即可使用。&#10;5. Esc、其他按键、鼠标操作、锁屏或睡眠会取消本轮自动输入。上一轮仍在整理时请稍后再按。"/><TextBlock Text="版本 1.3.0 · Windows x64 · Key 和本地文本通过当前 Windows 用户加密保存。" Foreground="{StaticResource Muted}" Margin="0,22,0,0"/></StackPanel></TabItem>
  </TabControl>
