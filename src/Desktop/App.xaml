<Application x:Class="RealtimeTranscription.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17293B"/><SolidColorBrush x:Key="Muted" Color="#617184"/><SolidColorBrush x:Key="Accent" Color="#226E67"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F3F6FA"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#D2DCE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CFD9E3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#94CEC6"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CFD9E3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,20,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="23,11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4EC"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/></Style>
</Application.Resources></Application>
